{
  "redirects": [
    { "source": "/spine/audit", "destination": "/spine/audit/", "permanent": false },
    { "source": "/spine/finance", "destination": "/spine/finance/", "permanent": false },
    { "source": "/chat", "destination": "/chat/", "permanent": false },
    { "source": "/readings", "destination": "/readings/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)\\.vcf",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" }
      ]
    }
  ],
  "functions": {
    "api/chat.js": { "maxDuration": 30 },
    "api/lead.js": { "maxDuration": 30 }
  }
}
